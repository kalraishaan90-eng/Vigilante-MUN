# ==========================================
# VIGILANTE MUN 4.0 - ENVIRONMENT VARIABLES
# ==========================================

# 1. Razorpay Payment Gateway Keys (Live or Test)
# Get from https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourRazorpayKeyHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretHere

# 2. EmailJS Client-Side Keys (Optional, for instant client email dispatch)
# Get from https://dashboard.emailjs.com/
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_xxxxxxx
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=user_xxxxxxx

# 3. Resend API Key (Optional, for server-side email dispatch)
# Get from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxx
